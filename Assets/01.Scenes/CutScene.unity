--- !u!114 &1599031976
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1599031975}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3637fccd9f408ff4eb7f8cca7e931b1c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  image: {fileID: 0}
  image01: {fileID: 0}
  text: {fileID: 748568082}
  textAll:
  - "\uC774 \uAC8C\uC784\uC740 \uD0C0\uC774\uBC0D \uAE30\uBC18\uC758 \uB514\uD39C\uC2A4
    \uAC8C\uC784\uC785\uB2C8\uB2E4."
  - "\uB9C8\uC6B0\uC2A4\uC758 \uC704\uCE58\uB85C \uB3CC\uC544\uAC00\uB294 \uB2EC\uC774
    \uC6B4\uC11D\uACFC \uB2FF\uC558\uC744 \uB54C \uC2A4\uD398\uC774\uC2A4 \uBC14\uB97C
    \uB204\uB974\uBA74 \uADF8 \uC6B4\uC11D\uC5D0 \uD53C\uD574\uB97C \uC8FC\uACE0,
    \uCE90\uB9AD\uD130\uAC00 \uC791\uC740 \uC6B4\uC11D\uC774 \uC788\uB294 \uBC29\uD5A5\uC73C\uB85C
    \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
  - "\uC6B4\uC11D\uC758 \uBC29\uD5A5\uC740 \uB9C8\uC6B0\uC2A4 \uC88C/\uC6B0\uD074\uB9AD\uC73C\uB85C
    \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "q, w, e\uB97C \uB204\uB974\uBA74 \uC810\uC218\uB97C \uC18C\uBAA8\uD558\uC5EC
    \uC2A4\uD0AC\uC744 \uBC1C\uB3D9\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "q\uC2A4\uD0AC\uC740 \uCE90\uB9AD\uD130\uC5D0\uAC8C \uACF5\uC804\uD558\uBA70
    \uB2FF\uB294 \uC801\uC744 \uD30C\uAD34\uD569\uB2C8\uB2E4."
  - "w\uC2A4\uD0AC\uC740 1\uD68C\uC6A9 \uBCF4\uD638\uB9C9\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4."
  - "e\uC2A4\uD0AC\uC740 \uC801\uC744 \uAD00\uD1B5\uD558\uB294 \uD22C\uC0AC\uCCB4\uB97C
    \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
  - "\uAC00\uB054 \uB179\uC0C9\uC758 \uC2ED\uC790\uAC00\uAC00 \uC0DD\uC131\uB418\uB294\uB370,
    \uC811\uCD09\uD558\uBA74 \uCCB4\uB825\uC774 \uD68C\uBCF5\uB429\uB2C8\uB2E4."
  - "\uC798... \uC990\uACA8\uC8FC\uC138\uC694..."
  _scene: Jupiter
